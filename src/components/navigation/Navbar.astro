---
import NavLinks from './NavLinks.astro';
import LanguageSelector from './LanguageSelector.astro';
import CTAButton from '../ui/CTAButton.astro';
import MobileMenuToggle from './MobileMenuToggle.astro';
import { SITE_CONFIG, CTA_TEXT } from '@/config/site';
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 ease-[var(--ease-smooth)]"
  role="banner"
>
  <nav
    class="container-max flex items-center justify-between h-20"
    aria-label="Navegación principal"
  >
    <!-- Logo -->
    <a
      href="#hero"
      class="group flex items-center gap-3 relative z-10"
      aria-label={`${SITE_CONFIG.name} — Volver al inicio`}
    >
      <span class="font-serif text-2xl font-semibold tracking-tight text-ivory transition-opacity duration-300 group-hover:opacity-80">
        Wander<span class="text-sunset">&</span>Wonder
      </span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-8">
      <NavLinks />
    </div>

    <!-- Right Actions -->
    <div class="hidden lg:flex items-center gap-6">
      <LanguageSelector />
      <CTAButton text={CTA_TEXT} href="#contact" size="sm" variant="solid" />
    </div>

    <!-- Mobile Menu Toggle -->
    <div class="lg:hidden">
      <MobileMenuToggle />
    </div>
  </nav>

</header>

<!-- Mobile Menu (Moved outside header to avoid backdrop-filter containing block bug) -->
<div
  id="mobile-menu"
  class="lg:hidden fixed inset-0 top-20 bg-midnight/98 backdrop-blur-lg opacity-0 pointer-events-none transition-opacity duration-500 ease-[var(--ease-smooth)] z-[45]"
  role="dialog"
  aria-label="Menú de navegación"
  aria-hidden="true"
>
  <div class="container-max flex flex-col items-center justify-center h-full gap-8 py-12">
    <NavLinks variant="mobile" />
    <div class="mt-4">
      <LanguageSelector />
    </div>
    <CTAButton text={CTA_TEXT} href="#contact" size="lg" variant="solid" />
  </div>
</div>

<script>
  function initNavbar(): void {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;

    let lastScrollY = window.scrollY;
    let isHidden = false;
    let isScrolled = false;
    let rafId: number | null = null;

    const SCROLL_THRESHOLD = 80; // px after which navbar gets translucent background
    const HIDE_THRESHOLD = 150;  // px after which navbar can auto-hide

    function updateNavbar(): void {
      const currentY = window.scrollY;
      const scrollingDown = currentY > lastScrollY;
      const delta = Math.abs(currentY - lastScrollY);

      // --- Sincronizar posición TOP con el scroll para el TopBar ---
      const topbarH = window.innerWidth <= 480 ? 34 : 38;
      navbar!.style.top = `${Math.max(0, topbarH - currentY)}px`;

      // Check near footer to auto hide floating navbar on mobile/desktop
      const pageBottom = document.documentElement.scrollHeight - window.innerHeight;
      const isNearFooter = currentY > pageBottom * 0.92;

      if (isNearFooter && currentY > HIDE_THRESHOLD) {
        if (!isHidden) {
          isHidden = true;
          navbar!.classList.add('navbar-hidden');
        }
        lastScrollY = currentY;
        rafId = null;
        return;
      }

      // --- Translucent background state ---
      if (currentY > SCROLL_THRESHOLD && !isScrolled) {
        isScrolled = true;
        navbar!.classList.add('navbar-scrolled');
      } else if (currentY <= SCROLL_THRESHOLD && isScrolled) {
        isScrolled = false;
        navbar!.classList.remove('navbar-scrolled');
      }

      // --- Smart hide / show ---
      if (currentY > HIDE_THRESHOLD) {
        if (scrollingDown && !isHidden && delta > 4) {
          // Hide when scrolling down
          isHidden = true;
          navbar!.classList.add('navbar-hidden');
        } else if (!scrollingDown && isHidden && delta > 4) {
          // Show when scrolling up
          isHidden = false;
          navbar!.classList.remove('navbar-hidden');
        }
      } else {
        // Always show near the top
        if (isHidden) {
          isHidden = false;
          navbar!.classList.remove('navbar-hidden');
        }
      }

      lastScrollY = currentY;
      rafId = null;
    }

    window.addEventListener('scroll', () => {
      if (rafId === null) {
        rafId = requestAnimationFrame(updateNavbar);
      }
    }, { passive: true });

    updateNavbar();
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>

<style>
  #navbar {
    background: transparent;
    transition:
      background 400ms cubic-bezier(0.25, 0.1, 0.25, 1),
      backdrop-filter 400ms cubic-bezier(0.25, 0.1, 0.25, 1),
      box-shadow 400ms cubic-bezier(0.25, 0.1, 0.25, 1),
      transform 400ms cubic-bezier(0.25, 0.1, 0.25, 1);
  }

  #navbar.navbar-hidden {
    transform: translateY(-120%);
  }

  #navbar.navbar-scrolled {
    background: rgba(13, 27, 42, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  #mobile-menu.is-open {
    opacity: 1;
    pointer-events: auto;
  }
</style>
